# ==========================================
# VISORA — Root Git Ignore
# ==========================================

# Operating System
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.suo
*.sw?

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# FRONTEND — Next.js
# ==========================================

frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/

# ==========================================
# BACKEND — Node.js
# ==========================================

backend/node_modules/

# TypeScript build cache
*.tsbuildinfo

# Backend build output
backend/dist/
