# ==========================================
# VISORA — Root Git Ignore (Frontend & Backend)
# ==========================================

# Operating System & IDE Files
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment Variables & Secrets
.env
.env*.local
.env.development
.env.production
.env.test
*.env

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# Frontend (Next.js / Node / React)
# ------------------------------------------
frontend/node_modules/
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

frontend/.next/
.next/
frontend/out/
out/
frontend/build/
build/
frontend/coverage/
coverage/
.vercel/

# TypeScript Build Cache
*.tsbuildinfo
next-env.d.ts

# Auto-generated agent docs
AGENTS.md
CLAUDE.md
frontend/AGENTS.md
frontend/CLAUDE.md

# ------------------------------------------
# Backend (Python / FastAPI / Node)
# ------------------------------------------
backend/node_modules/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
backend/env/
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Testing & Distribution
.pytest_cache/
.coverage
htmlcov/
dist/
*.egg-info/
.eggs/
*.egg
.mypy_cache/
.ruff_cache/

