# Copy to backend/.env and adjust. All values are optional; defaults are shown.

# Server
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed for HTTP (CORS) and WebSocket upgrades.
CORS_ORIGINS=http://localhost:3000

# Interview provider. Only "demo" (deterministic, no API key) is implemented so far.
LLM_PROVIDER=demo
# Provider calls slower than this fall back to the deterministic officer.
LLM_TIMEOUT_MS=15000

# Sessions are kept in memory on this single process.
SESSION_IDLE_TTL_MS=1800000
SESSION_SWEEP_INTERVAL_MS=60000
MAX_SESSIONS=200
WS_MAX_PAYLOAD_BYTES=65536
